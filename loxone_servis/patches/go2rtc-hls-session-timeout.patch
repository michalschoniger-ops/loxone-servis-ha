+func (s *Session) Segment(sequence int) []byte {
+	s.segmentMu.Lock()
+	defer s.segmentMu.Unlock()
+
+	if segment := s.segments[sequence]; segment != nil {
+		return segment
+	}
+	if sequence < s.seq || sequence > s.seq+1 {
+		return nil
+	}
+
+	for s.seq <= sequence {
+		segment := s.nextSegment()
+		if segment == nil {
+			return nil
+		}
+		s.segments[s.seq] = segment
+		delete(s.segments, s.seq-4)
+		s.seq++
+	}
+
+	return s.segments[sequence]
+}
